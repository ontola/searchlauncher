{
  "manifest_version": 2,
  "name": "SearchLauncher page metadata",
  "version": "1.2",
  "browser_specific_settings": {
    "gecko": {
      "id": "site-icons@searchlauncher.eu"
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "icons.js",
        "appearance.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ]
}
